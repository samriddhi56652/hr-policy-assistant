# Copy to .env and fill in your own values. Never commit .env.

# ── Google Cloud ──────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id
LOCATION=global                      # Gemini 3.x models are served from the global endpoint
REGION=us-central1                   # Cloud Run / bucket region
GCS_BUCKET_NAME=your-bucket-name

# ── Jina AI — embeddings + reranker ───────────────────────────
JINA_API_KEY=your-jina-api-key

# ── Qdrant Cloud — vector store ───────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# ── Models ────────────────────────────────────────────────────
LLM_MODEL_NAME=gemini-3.8-flash
EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual

# ── Groq — backup model + evaluation judge ────────────────────
GROQ_API_KEY=your-groq-api-key
FALLBACK_MODEL_NAME=openai/gpt-oss-20b
JUDGE_MODEL_NAME=openai/gpt-oss-120b

# ── Safety guardrail (Model Armor) ────────────────────────────
GUARDRAIL_PROVIDER=model_armor       # or "none" to switch it off locally
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE_ID=hr-assistant-guardrail

# ── LangSmith — evaluation (and optional tracing) ─────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=hr-policy-assistant

# ── Google sign-in: emails allowed into the app (comma-separated) ──
ALLOWED_EMPLOYEE_EMAILS=you@example.com,colleague@example.com
